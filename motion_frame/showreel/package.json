{
  "name": "raw-motion-frame-showreel",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-assets": "bash scripts/prepare-assets.sh",
    "music": "node scripts/music.mjs",
    "studio": "npm run prepare-assets && remotion studio",
    "render": "bash scripts/render.sh",
